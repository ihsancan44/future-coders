# docker compose için: bu dosyayı .env adıyla kopyalayıp doldurun.

# Zorunlu. Uzun ve rastgele olmalı: openssl rand -hex 32
JWT_SECRET=
# Zorunlu. Admin hesabının ilk şifresi (en az 10 karakter). Yalnızca ilk açılışta kullanılır;
# sonra şifreyi sitedeki profil sayfasından değiştirin.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@futurecoders.dev

# Sitenin herkese açık adresi (şifre sıfırlama e-postasındaki bağlantı bunu kullanır)
CLIENT_URL=http://localhost:8080

# Önünde HTTPS sağlayan ayrı bir ters vekil (Caddy, Traefik, Cloudflare...) varsa 2 yapın
TRUST_PROXY=1

# Şifre sıfırlama e-postaları için SMTP (boşsa e-posta gönderilmez)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Gönderen adresin alan adı sizin olmalı, yoksa e-postalar reddedilir
MAIL_FROM=Codevia <no-reply@ornek.com>

# Codevia Asistan (chatbot). Boşsa asistan kapalıdır. Anahtar: https://console.anthropic.com (ücretli)
ANTHROPIC_API_KEY=
# Derleyicide sunucuda çalışan diller için Wandbox uyumlu servis ("off" kapatır)
CODE_RUNNER_URL=https://wandbox.org
