# PostgreSQL bağlantısı
DATABASE_URL="postgresql://futurecoders:futurecoders@localhost:5432/futurecoders"
# Testler bu veritabanını sıfırlayıp kullanır
TEST_DATABASE_URL="postgresql://futurecoders:futurecoders@localhost:5432/futurecoders_test"

# Uzun ve rastgele bir değer verin (örn. `openssl rand -hex 32`)
JWT_SECRET="degistirin-cok-gizli-bir-anahtar"
JWT_EXPIRES_IN="7d"

PORT=4000
# Önündeki ters vekil (nginx vb.) sayısı; giriş denemesi sınırı gerçek ziyaretçi IP'sine göre işlesin
TRUST_PROXY=1
# Frontend adresi: CORS ve şifre sıfırlama bağlantısı için
CLIENT_URL="http://localhost:5173"

# Şifre sıfırlama e-postası. SMTP_HOST boşsa bağlantı sunucu loguna yazılır.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Codevia <no-reply@futurecoders.dev>"

# Seed ile oluşturulan admin hesabı
ADMIN_EMAIL="admin@futurecoders.dev"
ADMIN_PASSWORD="Admin12345"
