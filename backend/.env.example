# PostgreSQL bağlantısı
DATABASE_URL="postgresql://futurecoders:futurecoders@localhost:5432/futurecoders"
# Testler bu veritabanını sıfırlayıp kullanır
TEST_DATABASE_URL="postgresql://futurecoders:futurecoders@localhost:5432/futurecoders_test"

# Uzun ve rastgele bir değer verin (örn. `openssl rand -hex 32`)
JWT_SECRET="degistirin-cok-gizli-bir-anahtar"
JWT_EXPIRES_IN="7d"

PORT=4000
# Önündeki ters vekil (nginx vb.) sayısı; giriş denemesi sınırı gerçek ziyaretçi IP'sine göre işlesin
TRUST_PROXY=1
# Frontend adresi: CORS ve şifre sıfırlama bağlantısı için
CLIENT_URL="http://localhost:5173"
# Sitenin internetteki asıl adresi (örn. https://codevia.com.tr): sitemap.xml ve robots.txt bunu kullanır.
# Boşsa CLIENT_URL'deki ilk adres kullanılır.
SITE_URL=""

# Şifre sıfırlama e-postası. SMTP_HOST boşsa bağlantı sunucu loguna yazılır.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Codevia <no-reply@futurecoders.dev>"

# Seed ile oluşturulan admin hesabı
ADMIN_EMAIL="admin@futurecoders.dev"
ADMIN_PASSWORD="Admin12345"

# Codevia Asistan (chatbot). Boşsa asistan kapalıdır. Anahtar: https://console.anthropic.com (ücretli)
ANTHROPIC_API_KEY=""
# İsteğe bağlı: asistanın kullanacağı Claude modeli
ASSISTANT_MODEL="claude-opus-5-5"
# Derleyicide sunucuda çalışan diller (C, Java, Go...) bu ücretsiz servislerde çalışır; biri çökerse sıradakine geçilir.
# Sıra ve hangi servislerin açık olduğu. "off" sunucu dillerini kapatır.
CODE_RUNNERS="paiza,judge0,wandbox"
# İsteğe bağlı: kendi Judge0 kurulumunuz (Docker) ve anahtarı; boşsa herkese açık https://ce.judge0.com
JUDGE0_URL=""
JUDGE0_KEY=""
# İsteğe bağlı: Wandbox adresi (boşsa https://wandbox.org) ve paiza.io anahtarı (boşsa "guest")
CODE_RUNNER_URL=""
PAIZA_KEY=""
